<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <DataTemplate x:Key="WelcomeViewLarge">
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24" HorizontalAlignment="Left">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock Text="Welcome to &#10;COUNT-EZ" Opacity=".5" Style="{DynamicResource TextBlocks.Heading1}"/>
                    </Viewbox>
                </StackPanel>
            </Grid>

            <!-- Map -->
            <Grid Grid.Column="1" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource MapDataTemplate}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WelcomeViewMedium">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Viewbox Margin="60 24" StretchDirection="DownOnly">                
                <TextBlock Text="Welcome to COUNT-EZ" Opacity=".5" Style="{DynamicResource TextBlocks.Heading1}" HorizontalAlignment="Center"/>
            </Viewbox>

            <Border Grid.Row="1" Padding="48">                
                <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource MapDataTemplate}" VerticalAlignment="Top" />
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WelcomeViewSmall">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="24">
                <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource MapDataTemplate}" />
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>