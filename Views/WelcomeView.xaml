<UserControl x:Class="CountEZ.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CountEZ.Core.Converters"
             xmlns:const="clr-namespace:CountEZ.Models">

    <!-- Responsive Layout -->
    <Grid x:Name="welcomeRoot">
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <!-- Default Layout -->
                    <Setter Property="ContentTemplate" Value="{StaticResource WelcomeViewLarge}" />
                    <Style.Triggers>

                        <!-- Large Layout - width > 1400px-->
                        <DataTrigger Binding="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:IsGreaterThanConverter.Instance}, ConverterParameter={x:Static const:AppConstants.LAYOUT_LARGE}}" Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource WelcomeViewLarge}" />
                        </DataTrigger>

                        <!-- Medium Layout - width < 1024px-->
                        <DataTrigger Binding="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:IsLessThanConverter.Instance}, ConverterParameter={x:Static const:AppConstants.LAYOUT_MEDIUM}}"  Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource WelcomeViewMedium}" />
                        </DataTrigger>

                        <!-- Small Layout - width < 640px-->
                        <DataTrigger Binding="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static conv:IsLessThanConverter.Instance}, ConverterParameter={x:Static const:AppConstants.LAYOUT_SMALL}}"  Value="True">
                            <Setter Property="ContentTemplate" Value="{StaticResource WelcomeViewSmall}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</UserControl>