                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="path" Property="StrokeThickness" Value="1"/>
                            <Setter TargetName="path" Property="Fill" Value="{DynamicResource Brushes.AccentPrimary}"/>
                            <!--<Setter TargetName="path" Property="Stroke" Value="{DynamicResource Brushes.AccentPrimary}"/>-->
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value=".25"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>